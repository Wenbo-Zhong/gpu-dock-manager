msgid "; the original driver bindings were restored."
msgstr "；已恢復原驅動繫結。"

#: usb4_gpu_manager/displays.py:113 usb4_gpu_manager/kde_displays.py:86
msgid "A GPU operation is in progress. Wait or cancel the queued request."
msgstr "顯示卡操作正在進行，請等待完成或取消預約。"

