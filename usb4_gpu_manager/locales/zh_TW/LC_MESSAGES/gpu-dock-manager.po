#: usb4_gpu_manager/deployment.py:118
msgid ""
"Deploy one management service, retain NVIDIA's official sleep services, back "
"up existing configuration and update initramfs. Restart to apply."
msgstr ""
"部署一個管理服務；保留 NVIDIA 官方休眠服務；儲存現有配置並更新 initramfs，重"
"啟後生效。"

#: usb4_gpu_manager/gui.py:626
msgid "Deploy this device policy?"
msgstr "部署這套裝置策略？"

#: usb4_gpu_manager/gui.py:324 usb4_gpu_manager/gui.py:227
msgid "Deployment and recovery"
msgstr "部署與恢復"

#: usb4_gpu_manager/deployment.py:187
msgid ""
"Deployment complete; existing configuration backed up. Save your work and "
"restart to enable unified management."
msgstr "部署完成，現有配置已備份。請儲存工作並重啟，以啟用統一管理服務。"

#: usb4_gpu_manager/gui.py:336
msgid "Deployment contents"
msgstr "部署內容"

#: usb4_gpu_manager/deployment.py:155
msgid ""
"Deployment currently supports Ubuntu/Debian systems using initramfs-tools."
msgstr "首版部署支援使用 initramfs-tools 的 Ubuntu/Debian 系統。"

#: usb4_gpu_manager/deployment.py:183
msgid ""
"Deployment failed and configuration was restored, but rebuilding initramfs "
"failed. Check /boot space and run sudo update-initramfs -u -k all."
msgstr ""
"部署失敗，配置已恢復，但 initramfs 重建失敗。請檢查 /boot 空間並執行 sudo "
"update-initramfs -u -k all。"

