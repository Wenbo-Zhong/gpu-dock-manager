#, python-brace-format
msgid "Another tool has set driver_override for {p0}."
msgstr "{p0} 有其他工具設定的 driver_override。"

#: usb4_gpu_manager/gui.py:628
msgid "Authorize and deploy"
msgstr "授權並部署"

#: usb4_gpu_manager/gui.py:751
msgid "Authorize and restore"
msgstr "授權並恢復"

#: usb4_gpu_manager/controller.py:175
msgid "Automatic connection failed: "
msgstr "自動連線失敗："

#: usb4_gpu_manager/gui.py:339
msgid "Back up and migrate existing configuration"
msgstr "備份並遷移現有配置"

#: usb4_gpu_manager/gui.py:505
msgid "Based on this eGPU's DRM connectors"
msgstr "按 eGPU 自身的 DRM 介面判斷"

#: usb4_gpu_manager/gui.py:710
msgid ""
"Before unloading, pause nvidia-powerd and, if needed, briefly stop "
"WirePlumber (audio may be interrupted). Restore WirePlumber after the "
"operation. Restore nvidia-powerd if unloading fails or when the GPU is "
"loaded again."
msgstr ""
"卸載前自動暫停 nvidia-powerd，並按需短暫停止 WirePlumber（聲音可能中"
"斷）。操作結束後恢復 WirePlumber；卸載失敗或重新載入顯示卡時恢復 nvidia-"
"powerd。"

#: usb4_gpu_manager/gui.py:627 usb4_gpu_manager/gui.py:651
#: usb4_gpu_manager/gui.py:670 usb4_gpu_manager/gui.py:750
#: usb4_gpu_manager/gui.py:683
msgid "Cancel"
msgstr "取消"

#: usb4_gpu_manager/gui.py:300
msgid "Cancel request"
msgstr "取消預約"

#: usb4_gpu_manager/daemon.py:102
msgid "Cancel takes no options."
msgstr "取消操作不接收引數。"

