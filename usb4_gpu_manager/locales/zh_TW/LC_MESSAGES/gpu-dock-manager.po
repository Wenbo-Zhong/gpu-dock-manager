msgid "A new Mutter version is available"
msgstr "Mutter 有新版"

#: usb4_gpu_manager/daemon.py:99
msgid "Administrator authorization was denied."
msgstr "管理員授權未透過。"

#: usb4_gpu_manager/gui.py:324
msgid ""
"After reinstalling Linux, select devices and deploy again. Existing "
"configuration is backed up, and all changes can be previewed."
msgstr "重灌 Linux 後重新選擇裝置並部署；已有配置先備份，所有變更可預覽。"

#: usb4_gpu_manager/internal_gpu.py:138
msgid "Already loaded; no further load is needed."
msgstr "當前已載入，無需再次載入。"

#: usb4_gpu_manager/internal_gpu.py:138
msgid "Already unloaded; no further unload is needed."
msgstr "當前已卸載，無需再次卸載。"

#: usb4_gpu_manager/hardware.py:235
msgid "An external connector has an unknown state; removal refused."
msgstr "外接介面存在未知狀態，拒絕移除。"

#: usb4_gpu_manager/internal_gpu.py:52
msgid "An unsupported driver binding exists."
msgstr "存在不受支援的驅動繫結。"

#: usb4_gpu_manager/controller.py:304
msgid "Another driver holds the target GPU; takeover refused."
msgstr "目標顯示卡由其他驅動佔用，拒絕接管。"

#: usb4_gpu_manager/daemon.py:111
msgid "Another operation is in progress."
msgstr "已有操作正在進行。"

#: usb4_gpu_manager/controller.py:399
msgid "Another operation is in progress. Wait or cancel the queued request."
msgstr "已有操作正在進行，請稍候或取消預約。"

