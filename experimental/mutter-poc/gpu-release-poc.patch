--- /dev/null
+++ b/src/backends/native/meta-gpu-drm-only-poc.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <glib-object.h>
+#include "meta-gpu-release-poc.h"
+
+#define GPU_POC_DRM_ONLY_KEY "gpu-release-poc-drm-only"
+#define GPU_POC_HW_CURSOR_VIEW_KEY "gpu-release-poc-hw-cursor-view"
+
+static inline gboolean
+gpu_poc_drm_policy_matches (const char *requested,
+                            const char *actual,
+                            const char *vendor,
+                            const char *boot_vga,
+                            const char *removable)
+{
+  return gpu_release_poc_enabled () && requested &&
+    g_regex_match_simple ("^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$", requested, 0, 0) &&
+    g_strcmp0 (requested, actual) == 0 &&
+    g_strcmp0 (vendor, "0x10de\n") == 0 &&
+    g_strcmp0 (boot_vga, "0\n") == 0 &&
+    g_strcmp0 (removable, "removable\n") == 0;
+}
+
+static inline gboolean
+gpu_poc_internal_policy_matches (const char *requested,
+                                 const char *actual,
+                                 const char *vendor,
+                                 const char *product,
+                                 const char *boot_vga,
+                                 const char *removable)
+{
+  return gpu_release_poc_enabled () && requested &&
+    g_regex_match_simple ("^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.0$", requested, 0, 0) &&
+    g_strcmp0 (requested, actual) == 0 &&
+    g_strcmp0 (vendor, "0x10de\n") == 0 &&
+    g_strcmp0 (product, "0x2820\n") == 0 &&
+    g_strcmp0 (boot_vga, "0\n") == 0 &&
+    g_strcmp0 (removable, "removable\n") != 0;
+}
+
+static inline gboolean
+gpu_poc_drm_only_path (const char *path)
+{
+  const char *requested = g_getenv ("MUTTER_GPU_RELEASE_POC_DRM_ONLY_PCI");
+  const char *internal = g_getenv ("MUTTER_GPU_RELEASE_POC_DRM_ONLY_INTERNAL_PCI");
+  g_autofree char *name = NULL, *base = NULL, *link = NULL, *actual = NULL;
+  g_autofree char *vendor = NULL, *boot = NULL, *removable = NULL;
+  g_autofree char *vendor_path = NULL, *boot_path = NULL, *removable_path = NULL;
+  g_autofree char *product = NULL, *product_path = NULL;
+
+  if (!gpu_release_poc_enabled () || (!requested && !internal) || !path)
+    return FALSE;
+  name = g_path_get_basename (path);
+  if (!g_regex_match_simple ("^(card[0-9]+|renderD[0-9]+)$", name, 0, 0))
+    return FALSE;
+  base = g_build_filename ("/sys/class/drm", name, "device", NULL);
+  link = g_file_read_link (base, NULL);
+  if (!link)
+    return FALSE;
+  actual = g_path_get_basename (link);
+  vendor_path = g_build_filename (base, "vendor", NULL);
+  boot_path = g_build_filename (base, "boot_vga", NULL);
+  removable_path = g_build_filename (base, "removable", NULL);
+  product_path = g_build_filename (base, "device", NULL);
+  if (!g_file_get_contents (vendor_path, &vendor, NULL, NULL) ||
+      !g_file_get_contents (boot_path, &boot, NULL, NULL))
+    return FALSE;
+  g_file_get_contents (removable_path, &removable, NULL, NULL);
+  g_file_get_contents (product_path, &product, NULL, NULL);
+  return gpu_poc_drm_policy_matches (requested, actual, vendor, boot, removable) ||
+    gpu_poc_internal_policy_matches (internal, actual, vendor, product, boot, removable);
+}
+
+static inline gboolean
+gpu_poc_drm_only (gpointer object)
+{
+  return object && g_object_get_data (G_OBJECT (object), GPU_POC_DRM_ONLY_KEY) != NULL;
+}
--- /dev/null
+++ b/src/backends/native/meta-gpu-release-poc.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <glib.h>
+#include <errno.h>
+
+static inline gboolean
+gpu_release_poc_enabled (void)
+{
+  return g_strcmp0 (g_getenv ("MUTTER_GPU_RELEASE_POC"), "1") == 0;
+}
+
+static inline void
+gpu_release_poc_clean_child_environment (void)
+{
+  const char *data_dirs;
+
+  if (!gpu_release_poc_enabled () ||
+      g_strcmp0 (g_getenv ("MUTTER_GPU_RELEASE_POC_CLEAN_CHILD_ENV"), "1") != 0)
+    return;
+  data_dirs = g_getenv ("MUTTER_GPU_RELEASE_POC_ORIGINAL_DATA_DIRS");
+  /* The dynamic loader has already captured its startup search paths. Keep
+   * those paths out of environments passed to applications launched by Shell. */
+  if (data_dirs)
+    g_setenv ("XDG_DATA_DIRS", data_dirs, TRUE);
+  g_unsetenv ("LD_LIBRARY_PATH");
+  g_unsetenv ("MUTTER_GPU_RELEASE_POC_ORIGINAL_DATA_DIRS");
+  g_message ("GPU-RELEASE-POC event=child-environment-cleaned");
+}
+
+static inline gboolean
+gpu_release_poc_trace_device (const char *path)
+{
+  const char *filter = g_getenv ("MUTTER_GPU_RELEASE_POC_TRACE_DEVICE");
+
+  return gpu_release_poc_enabled () && filter &&
+    g_strcmp0 (filter, path) == 0;
+}
+
+#define GPU_POC_LOG(...) G_STMT_START { \
+  if (gpu_release_poc_enabled ()) \
+    g_message ("GPU-RELEASE-POC " __VA_ARGS__); \
+} G_STMT_END
+
+/* Low-frequency lifecycle boundaries only; never called from frame dispatch.
+ * These are non-atomic observations. fd numbers can be reused or changed by
+ * another thread; they are evidence, not ownership or safe-eject decisions.
+ */
+static inline void
+gpu_release_poc_fds (const char *stage,
+                     const void *object)
+{
+  int saved_errno;
+  g_autoptr (GDir) directory = NULL;
+  const char *name;
+  guint scanned = 0, matched = 0;
+
+  if (!gpu_release_poc_enabled () ||
+      g_strcmp0 (g_getenv ("MUTTER_GPU_RELEASE_POC_TRACE_FDS"), "1") != 0)
+    return;
+  saved_errno = errno;
+  directory = g_dir_open ("/proc/self/fd", 0, NULL);
+  if (!directory)
+    {
+      GPU_POC_LOG ("event=fd-snapshot-unavailable stage=%s object=%p", stage, object);
+      errno = saved_errno;
+      return;
+    }
+  while ((name = g_dir_read_name (directory)) && scanned < 4096)
+    {
+      g_autofree char *path = g_build_filename ("/proc/self/fd", name, NULL);
+      g_autofree char *target = g_file_read_link (path, NULL);
+
+      scanned++;
+      if (target && (g_str_has_prefix (target, "/dev/nvidia") ||
+                     g_str_has_prefix (target, "/dev/dri/")))
+        {
+          matched++;
+          GPU_POC_LOG ("event=fd-snapshot stage=%s object=%p thread=%p time_us=%" G_GINT64_FORMAT " fd=%s node=%s",
+                       stage, object, g_thread_self (), g_get_monotonic_time (), name, target);
+        }
+    }
+  GPU_POC_LOG ("event=fd-snapshot-end stage=%s object=%p matched=%u truncated=%d",
+               stage, object, matched, name != NULL);
+  g_clear_pointer (&directory, g_dir_close);
+  errno = saved_errno;
+}
